# Development only. Generate a new database password before exposing a deployment.
POSTGRES_PASSWORD=talentlens-local-only
DATABASE_URL=postgresql+psycopg://talentlens:talentlens-local-only@db:5432/talentlens
REDIS_URL=redis://redis:6379/0
APP_ORIGIN=http://localhost:3000
FRONTEND_PORT=3000
COOKIE_SECURE=false
ENVIRONMENT=development
STORAGE_PATH=/data/resumes
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=
AWS_DEFAULT_REGION=us-east-1
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_REVISION=c9745ed1d9f207416be6d2e6f8de32d1f16199bf
SPACY_MODEL=en_core_web_sm
HF_HOME=/data/models
API_INTERNAL_URL=http://api:8000
DEMO_MODE=false

# Account access: connect a real SMTP provider before enabling public production.
REQUIRE_EMAIL_VERIFICATION=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls
# Public production requires ClamAV. Local development leaves scanning disabled.
UPLOAD_SCANNING=disabled
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
